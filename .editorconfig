root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psm1,psd1,cs,xaml,cmd,bat}]
# PowerShell 5.1, Windows batch i C# projekti prate Windows CRLF konvenciju gde već postoji, uz UTF-8
indent_size = 4

[*.{json,yml,yaml,md,css,js,html}]
indent_size = 2
