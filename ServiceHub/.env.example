# ServiceHub Docker / TrueNAS Konfiguracija Okruzenja
SERVIS_HUB_PORT=8080
SERVIS_HUB_UDP_PORT=8888

# Obavezni admin token za destruktivne/operaterske POST rute (/api/wis/usb/burn, /api/updates/prune, /api/devices/<id>/command)
# Podrazumevano fail-closed (HTTP 503 dok token nije postavljen), osim ako eksplicitno ukljucite SERVIS_HUB_ALLOW_UNAUTHENTICATED_LAN=1
SERVIS_HUB_ADMIN_TOKEN=

# Opcioni klijentski token za upload zakrpi i <Model>.tar paketa (/api/updates/upload, /api/drivers/model-pack/upload)
SERVIS_HUB_CLIENT_TOKEN=

# Eksplicitni opt-in za otvoreni LAN rezim bez tokena u fizicki izolovanoj radionickoj mrezi (0 ili 1)
SERVIS_HUB_ALLOW_UNAUTHENTICATED_LAN=0

# Dozvoljeni CORS origin-i razdvojeni zarezom (prazno = samo same-origin bez wildcard '*')
SERVIS_HUB_CORS_ORIGINS=

# Host putanje za volume mountove u docker-compose.yml
SERVIS_HUB_STORAGE_SRC=/mnt/TK_NAS/Servis/servis-hub/storage
SERVIS_HUB_REPORTS_SRC=/mnt/TK_NAS/Servis/servis-hub/Logs/reports
SERVIS_HUB_LIVE_LOGS_SRC=/mnt/TK_NAS/Servis/servis-hub/Logs/live
SERVIS_UPDATES_SRC=/mnt/TK_NAS/Servis/Updates/Win11
SERVIS_HARVESTED_SRC=/mnt/TK_NAS/Servis/Drivers/Harvested/Archives
